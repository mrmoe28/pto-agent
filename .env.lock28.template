# Lock28 environment variables for pto-agent
# Paste into Lock28 → Application → Environment Variables (Bulk Edit)
# Values marked REPLACE must be updated. Values marked KEEP come from .env.vercel as-is.

# === Database ===
# PATH A (keep Neon): copy DATABASE_URL + all POSTGRES_*/PG* lines verbatim from .env.vercel
# PATH B (Lock28 Postgres): replace with the connection string from Lock28 Postgres "Connection" tab
DATABASE_URL=REPLACE_WITH_LOCK28_OR_NEON_URL
DATABASE_URL_UNPOOLED=REPLACE_WITH_LOCK28_OR_NEON_URL

# === Clerk Auth === (KEEP — same keys work on any host; just add new origin in Clerk dashboard)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWKS_URL=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# === App URLs === (REPLACE with Lock28-served domain)
NEXT_PUBLIC_APP_URL=https://ptoagent.app
NEXT_PUBLIC_BASE_URL=https://ptoagent.app

# === Stripe === (KEEP keys; REPLACE webhook secret after recreating endpoint)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRO_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=REPLACE_AFTER_CREATING_NEW_WEBHOOK_ENDPOINT

# === Google APIs === (KEEP)
GOOGLE_PLACES_API_KEY=
GOOGLE_MAPS_API_KEY=
GOOGLE_CUSTOM_SEARCH_API_KEY=
GOOGLE_CUSTOM_SEARCH_ENGINE_ID=
NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=

# === OpenAI === (KEEP)
OPENAI_API_KEY=

# === Scraper ===
ENABLE_DYNAMIC_SCRAPER=true

# === Node runtime ===
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

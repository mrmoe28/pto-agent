{
  "description": "Known platform URLs and hints for permit portals by state/county",
  "platforms": {
    "accela": {
      "description": "Accela Citizen Access portals",
      "common_patterns": [
        "/CitizenAccess/",
        "citizenaccess.",
        "permits.accela.com"
      ],
      "known_instances": {
        "GA": [
          "https://aca.fultoncountyga.gov/CitizenAccess/",
          "https://aca.dekalbcountyga.gov/CitizenAccess/"
        ],
        "AL": [
          "https://permits.jccal.org/citizenaccess/Default.aspx",
          "https://aca-prod.accela.com/BIRMINGHAM/Default.aspx"
        ],
        "NC": [
          "https://webpermit.mecklenburgcountync.gov/"
        ]
      }
    },
    "etrakit": {
      "description": "eTRAKiT permitting systems",
      "common_patterns": [
        "/etrakit/",
        "etrakit.",
        "permits.etrakit.com"
      ],
      "known_instances": {
        "SC": [
          "https://etrakit.rcgov.us/",
          "https://grvlc-trk.aspgov.com/eTRAKiT/"
        ]
      }
    },
    "tyler-energov": {
      "description": "Tyler Technologies EnerGov",
      "common_patterns": [
        "/energov/",
        "energov.",
        "permits.tylertech.com"
      ],
      "known_instances": {}
    },
    "cityview": {
      "description": "CityView/Cartegraph permits",
      "common_patterns": [
        "cityview",
        "cartegraph",
        "/cityview/"
      ],
      "known_instances": {}
    },
    "opengov": {
      "description": "OpenGov public forms and permits",
      "common_patterns": [
        "opengov.com",
        "forms.opengov.com",
        "app.opengov.com"
      ],
      "known_instances": {}
    },
    "civicplus": {
      "description": "CivicPlus CMS with document centers",
      "common_patterns": [
        "/DocumentCenter/",
        "civicplus",
        "civicweb"
      ],
      "known_instances": {}
    },
    "salesforce-exp": {
      "description": "Salesforce Experience Cloud",
      "common_patterns": [
        ".force.com",
        "force.com/public",
        "lightning"
      ],
      "known_instances": {}
    },
    "fasttrack": {
      "description": "FastTrack permitting systems (Orange County FL)",
      "common_patterns": [
        "fasttrack.",
        "/onlineservices/",
        "fasttrack permitting"
      ],
      "known_instances": {
        "FL": [
          "https://fasttrack.ocfl.net/OnlineServices/"
        ]
      }
    },
    "miami-dade-eps": {
      "description": "Miami-Dade Electronic Permitting System",
      "common_patterns": [
        "/Apps/RER/EPSPortal/",
        "miamidade.gov/permits"
      ],
      "known_instances": {
        "FL": [
          "https://www.miamidade.gov/Apps/RER/EPSPortal/"
        ]
      }
    }
  },
  "state_hints": {
    "GA": {
      "notes": "Strong Accela presence in metro Atlanta counties",
      "major_counties": ["Fulton", "DeKalb", "Cobb", "Gwinnett"],
      "portal_types": ["accela", "civicplus"]
    },
    "CA": {
      "notes": "Mix of Accela, Tyler EnerGov, and custom systems",
      "major_counties": ["Los Angeles", "Orange", "San Diego"],
      "portal_types": ["accela", "tyler-energov", "opengov"]
    },
    "TX": {
      "notes": "Tyler EnerGov common, some Accela instances",
      "major_counties": ["Harris", "Dallas", "Tarrant"],
      "portal_types": ["tyler-energov", "accela"]
    },
    "FL": {
      "notes": "Mix of platforms, many custom implementations",
      "major_counties": ["Miami-Dade", "Broward", "Orange"],
      "portal_types": ["accela", "etrakit", "civicplus"]
    }
  }
}
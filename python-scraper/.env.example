# Environment Configuration Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env files with real credentials to version control

# Database Configuration
# Production: Use your actual Neon/Supabase URL
# Development: Use local PostgreSQL
DATABASE_URL=postgresql://localhost:5432/permit_offices_dev

# Google APIs
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# LocationIQ for geocoding
LOCATIONIQ_ACCESS_TOKEN=your_locationiq_token_here

# Optional: Redis for rate limiting (if using)
REDIS_URL=redis://localhost:6379

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
# Docker Environment Variables for Permit Office Scraper
# Use this file for Docker Compose deployment

# Database Configuration
DATABASE_URL=postgresql://scraper:scraper_password@postgres:5432/permit_offices

# Google APIs (use your existing keys)
GOOGLE_MAPS_API_KEY=AIzaSyAr5knif73PEUZK4nQjGg0-2Bbw6-aIHbo
GOOGLE_PLACES_API_KEY=AIzaSyAr5knif73PEUZK4nQjGg0-2Bbw6-aIHbo

# Scraping Configuration
SCRAPING_DELAY=1.0
MAX_RETRIES=3
